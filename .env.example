APP_ENV=local

# LLM (proveedor intercambiable): ollama | openai
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://ollama:11434
# LLM hosted (para deploy): LLM_PROVIDER=openai, LLM_MODEL=llama-3.1-8b-instant
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_API_KEY=

# Embeddings
EMBEDDINGS_MODEL=intfloat/multilingual-e5-base

# Vector store
VECTOR_STORE=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
COLLECTION_NAME=bbva

# RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Memoria de conversación
HISTORY_N=6
DB_PATH=data/conversations.sqlite3

# Scraping
SCRAPER_BASE_URL=https://www.scotiabankcolpatria.com/
SCRAPER_MAX_PAGES=50

# API (orígenes permitidos por CORS, separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
