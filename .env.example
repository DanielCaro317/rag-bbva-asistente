APP_ENV=local

# LLM (proveedor intercambiable)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://ollama:11434

# Embeddings
EMBEDDINGS_MODEL=intfloat/multilingual-e5-base

# Vector store
VECTOR_STORE=qdrant
QDRANT_URL=http://qdrant:6333
COLLECTION_NAME=bbva

# RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Memoria de conversación
HISTORY_N=6
DB_PATH=/app/data/conversations.sqlite3

# Scraping
SCRAPER_BASE_URL=https://www.bbva.com.co/
SCRAPER_MAX_PAGES=50
